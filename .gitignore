# Dataset
# The full MonReader dataset is hundreds of MB and is not suitable for git.
# Users download it from the Google Drive link in README.md and extract it
# into ./images/. The small sample frames (whitelisted below) are kept in
# the repo so the notebook can be inspected without first downloading.
#
# images_ignore/ is a convention for any local-only staging copies of the
# data (full dataset backups, zips, etc.) and is always ignored.
images_ignore/
images/training/**
images/testing/**
!images/training/flip/
!images/training/notflip/
!images/testing/flip/
!images/testing/notflip/
!images/training/flip/.gitkeep
!images/training/notflip/.gitkeep
!images/testing/flip/.gitkeep
!images/testing/notflip/.gitkeep
# Explicit whitelist of the 10 sample frames committed with the repo.
!images/training/flip/0001_000000020.jpg
!images/training/flip/0002_000000012.jpg
!images/training/flip/0002_000000013.jpg
!images/training/flip/0002_000000015.jpg
!images/training/flip/0002_000000017.jpg
!images/training/notflip/0001_000000002.jpg
!images/training/notflip/0001_000000004.jpg
!images/training/notflip/0001_000000009.jpg
!images/training/notflip/0001_000000014.jpg
!images/training/notflip/0001_000000024.jpg
!images/testing/flip/0001_000000020.jpg
!images/testing/flip/0002_000000012.jpg
!images/testing/flip/0002_000000013.jpg
!images/testing/flip/0002_000000015.jpg
!images/testing/flip/0002_000000017.jpg
